# Build-time ImpulseM settings. Empty means "not configured": the app does not dial a
# transport host, and links and menu entries that need a value are hidden.
# CI passes these from the organisation variables; locally set them in .env.local.

# Base URL of the transport host (gRPC-web, Centrifugo, Loki push), e.g. https://rpc.example.org
IMPULSEM_RPC_URL=

# Base URL of the project website, no trailing slash, e.g. https://example.org
IMPULSEM_SITE_URL=

# Host of public share links (the t.me equivalent), e.g. o.example.org
IMPULSEM_LINK_HOST=

# URL of the web client, e.g. https://web.example.org/k
IMPULSEM_WEB_URL=

# Base URL of the translations export used by pnpm apply-new-lang
IMPULSEM_TRANSLATIONS_URL=
