# Base image
FROM node:24

# Set the working directory in the container
WORKDIR /app

# copy src
COPY .. .

# install pnpm
RUN npm install -g pnpm@11.16.0

# install initial depenancies
RUN pnpm install

# install production depencancies
RUN pnpm install --production

# build-time ImpulseM settings (src/config/impulsemConfig.ts), passed with --build-arg
ARG IMPULSEM_RPC_URL=
ARG IMPULSEM_SITE_URL=
ARG IMPULSEM_LINK_HOST=
ARG IMPULSEM_WEB_URL=
ARG IMPULSEM_TRANSLATIONS_URL=

# build
RUN node build


#pull nginx as webser and load balancer
FROM nginx:stable-alpine3.20-slim

RUN apk update && apk upgrade --no-cache

# copy the build files to nginx entry point
COPY ./public /usr/share/nginx/html
